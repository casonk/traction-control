# Build: scripts/install_azure_win_broker.sh builds this on the Azure Linux VM (it has no registry).
FROM docker.io/library/golang:1.26 AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/win-broker ./cmd/win-broker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/win-broker /win-broker
USER 65532:65532
ENTRYPOINT ["/win-broker"]
