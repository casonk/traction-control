# KeePass-via-snowbridge config for macOS.
# Copy to config/keepass-snowbridge.env.local — the .local file is gitignored.
# Passwords are stored in macOS Keychain by setup_keepass_snowbridge.sh; never
# put them in this file.

# Hostname or IP of the snowbridge server.
# Use the LAN hostname (e.g. snowbridge.local) when on the home network, or the
# WireGuard/Tailscale tunnel address when connecting remotely.
SNOWBRIDGE_HOST=snowbridge.local

# Samba account used for SMB authentication (matches 'valid users' in smb.conf).
SNOWBRIDGE_SMB_USER=snowbridge

# SMB share name (the [section] name in smb.conf on the server).
SNOWBRIDGE_SMB_SHARE=snowbridge

# Local macOS mount point.
# Use a user-owned path — /Volumes/ requires root to create directories in.
SNOWBRIDGE_MOUNT_POINT=${HOME}/mnt/snowbridge

# KeePass vault paths relative to the share root (space-separated).
# Example: "KeePass/personal.kdbx KeePass/work.kdbx"
KEEPASS_VAULT_SUBPATHS="KeePass/vault.kdbx"

# auto-pass profile name written into auto-pass env when setup runs.
# Each vault subpath gets its own profile: <KEEPASS_AUTO_PASS_PROFILE_PREFIX>_<index>.
KEEPASS_AUTO_PASS_PROFILE_PREFIX=snowbridge
