# One scale set per private repository (a personal account has no shared runners). Copy to an ignored file, set
# githubConfigUrl and runnerScaleSetName (the name is the `runs-on` label), and install with
# scripts/install_k3s_arc_runner.sh. Holds no credentials.
githubConfigUrl: https://github.com/OWNER/REPOSITORY
githubConfigSecret: runner-auth
runnerScaleSetName: REPOSITORY-ci
minRunners: 0
maxRunners: 1
controllerServiceAccount:
  namespace: arc-systems
  name: arc-gha-rs-controller
# The chart's listener pod sets no security context, which the restricted namespace rejects.
listenerTemplate:
  spec:
    securityContext:
      runAsNonRoot: true
      runAsUser: 1001
      seccompProfile: {type: RuntimeDefault}
    containers:
      - name: listener
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities: {drop: [ALL]}
template:
  spec:
    automountServiceAccountToken: false
    securityContext:
      runAsNonRoot: true
      runAsUser: 1001
      runAsGroup: 123
      fsGroup: 123
      seccompProfile: {type: RuntimeDefault}
    containers:
      - name: runner
        image: localhost:5000/arc-runner:2.338.2  # build with scripts/build_k3s_arc_runner_image.sh
        command: ["/home/runner/run.sh"]
        env:
          # setup-python installs interpreters here; the image's default tool cache is root-owned.
          - {name: RUNNER_TOOL_CACHE, value: /home/runner/_work/_tool}
          - {name: AGENT_TOOLSDIRECTORY, value: /home/runner/_work/_tool}
        volumeMounts:
          # Some tests look for a login-style runtime directory (/run/user/<uid>); a hosted runner has one.
          - {name: run-user, mountPath: /run/user/1001}
        securityContext:
          allowPrivilegeEscalation: false
          capabilities: {drop: [ALL]}
        resources:
          requests: {cpu: 250m, memory: 512Mi}
          limits: {cpu: "2", memory: 3Gi, ephemeral-storage: 8Gi}
    volumes:
      - name: run-user
        emptyDir: {medium: Memory, sizeLimit: 16Mi}
