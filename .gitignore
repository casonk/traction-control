# Local session memory
CHATHISTORY.md
.codex

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
__pycache__/
.idea/
.vscode/

# Local automation scratch space
artifacts/
reports/
scan-cache/

CLAUDE.md

.tachometer/

/REFS-LOCAL.md

# Azure runner Terraform: local provider cache and any state created in-tree.
# The wrapper keeps the real state outside the repository.
infra/azure-runner/terraform/.terraform/
infra/azure-runner/terraform/*.tfstate
infra/azure-runner/terraform/*.tfstate.*
infra/azure-runner/terraform/*.tfplan
infra/azure-runner/terraform/*.tfvars
infra/azure-runner/terraform/*.tfvars.json
infra/azure-runner/terraform/crash.log
infra/azure-runner/terraform/crash.*.log

# Azure Windows runner Terraform: local provider cache and any in-tree state or variables.
infra/azure-windows-runner/terraform/.terraform/
infra/azure-windows-runner/terraform/*.tfstate
infra/azure-windows-runner/terraform/*.tfstate.*
infra/azure-windows-runner/terraform/*.tfplan
infra/azure-windows-runner/terraform/*.tfvars
infra/azure-windows-runner/terraform/*.tfvars.json
infra/azure-windows-runner/terraform/crash.log
infra/azure-windows-runner/terraform/crash.*.log

# Golden runner disk images and their backups are large and belong outside Git
# (scripts/backup_azure_runner_images.sh writes under ~/.local/share/portfolio-backups).
*.vhd
*.vhdx
*.vhd.zst
*.vhd.partial
*.qcow2
runner-images/

# Windows runner broker: the allowlist names private repositories, so it stays local.
config/github-runners/windows/*.local.*

# KeePass-snowbridge local config (contains host/path details, no passwords)
config/keepass-snowbridge.env.local

# Air-primary render orchestration (machine paths, interface allocation, and
# private service locations; the tracked example is intentionally synthetic).
config/air-primary.local.toml

# Agent-local state: machine-specific settings and scratch worktrees.
.claude/

# Local portfolio backlog rollup and its optional reviewed-title map.  The
# canonical work items remain in each repository's tracked BACKLOG.md.
/config/portfolio/backlog-index.local.json
/reports/portfolio-backlog.md

# coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# azure-vm-stack: local provider cache and any in-tree state or variables.
infra/azure-vm-stack/.terraform/
infra/azure-vm-stack/*.tfstate
infra/azure-vm-stack/*.tfstate.*
infra/azure-vm-stack/*.tfplan
infra/azure-vm-stack/*.tfvars
infra/azure-vm-stack/*.tfvars.json
infra/azure-vm-stack/crash.log
infra/azure-vm-stack/crash.*.log


# azure-static-web-app-stack: local provider cache and any in-tree state or variables.
infra/azure-static-web-app-stack/.terraform/
infra/azure-static-web-app-stack/*.tfstate
infra/azure-static-web-app-stack/*.tfstate.*
infra/azure-static-web-app-stack/*.tfplan
infra/azure-static-web-app-stack/*.tfvars
infra/azure-static-web-app-stack/*.tfvars.json
infra/azure-static-web-app-stack/crash.log
infra/azure-static-web-app-stack/crash.*.log

# Bulk-storage audit: machine-local path declarations.
config/bulk-storage.local.toml

# Local-state backup: machine-local dataset lists and extras name private repositories and paths.
config/state-datasets.local.toml
config/local-state.local.toml

# Resource limits: the registry and its audit log name real scheduled jobs.
config/resource-limits/*.local.*
